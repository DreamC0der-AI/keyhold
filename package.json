{
  "name": "keyhold",
  "version": "0.1.0",
  "description": "Login, key management and end-to-end encryption for web apps, as three separable modules.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "default": "./dist/keys/index.js"
    },
    "./keys/browser": {
      "types": "./dist/keys/browser.d.ts",
      "default": "./dist/keys/browser.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/server": {
      "types": "./dist/auth/server.d.ts",
      "default": "./dist/auth/server.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:browser": "node tests/browser/run.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "esbuild": "^0.25.0"
  }
}
